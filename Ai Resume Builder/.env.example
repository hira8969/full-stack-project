# Environment Variables Configuration
# Copy this file to .env and replace placeholders with actual values.

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root_secret_password
MYSQL_USER=resume_db_user
MYSQL_PASSWORD=resume_db_password
MYSQL_URL_AUTH=jdbc:mysql://localhost:3306/resume_platform_auth?useSSL=false&serverTimezone=UTC
MYSQL_URL_MAIN=jdbc:mysql://localhost:3306/resume_platform_main?useSSL=false&serverTimezone=UTC
MYSQL_URL_ANALYTICS=jdbc:mysql://localhost:3306/resume_platform_analytics?useSSL=false&serverTimezone=UTC

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_GROUP_ID=resume-platform-group

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_that_must_be_at_least_256_bits_long_for_hs256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email (SMTP) Settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@resumeplatform.com

# MinIO (S3 Compatible Storage) Settings
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_secret_password
MINIO_URL=http://localhost:9000
MINIO_BUCKET_NAME=resumes

# AWS S3 Settings (Optional, overrides MinIO if configured)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Elasticsearch Settings
ELASTICSEARCH_URL=http://localhost:9200

# AI Services Configuration
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Microservices Ports
EUREKA_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
RESUME_SERVICE_PORT=8083
RESUME_BUILDER_SERVICE_PORT=8084
RESUME_ANALYZER_SERVICE_PORT=8085
AI_RECOMMENDATION_SERVICE_PORT=8086
JOB_SERVICE_PORT=8087
RECRUITER_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8089
ANALYTICS_SERVICE_PORT=8090
FRONTEND_PORT=4200
